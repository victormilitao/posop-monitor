{
  "cli": {
    "version": ">= 18.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_TARGET": "remote"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND_TARGET": "remote"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "distribution": "store",
      "environment": "production",
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "env": {
        "EXPO_PUBLIC_BACKEND_TARGET": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6832781878"
      }
    }
  }
}
